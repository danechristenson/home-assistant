#!/bin/sh
# Sets a password for the Matrix account of the Home Assistant user who opened
# the panel, so they can sign in to phone apps (Element X, FluffyChat).
#
# POST, body: the new password
#
# Continuwuity only lets an admin command set a password for an account that
# has none (accounts created by sidebar sign-in), so this reloads the server's
# settings with that one command in admin_signal_execute (SIGUSR1), runs it
# (SIGUSR2), checks the password works, then clears the command again. The
# command's output repeats the password, so run.sh drops the server's console
# output while the lock below exists.

. /usr/lib/matrix/cgi.sh

SIGNAL_CONFIG=/tmp/admin-signal.toml
LOCK=/tmp/password.lock

[ "$REQUEST_METHOD" = "POST" ] || reply '{"enabled":true,"error":"Use POST."}'

PASSWORD=$(head -c "${CONTENT_LENGTH:-0}")
# Printable characters except spaces and ' (the admin command is split on
# spaces and quoted with '), not starting with - (it would read as an option)
if ! printf '%s' "$PASSWORD" | grep -qE '^[!-&(-~]{8,128}$' || [ "${PASSWORD#-}" != "$PASSWORD" ]; then
    reply '{"enabled":true,"error":"Use 8 to 128 characters: letters, numbers and symbols, with no spaces or apostrophes, not starting with a dash."}'
fi

# Only existing, active accounts: the command would reactivate a deactivated
# one. Signing in through the appservice fails for both; sign straight out.
CHECK=$(api /_matrix/client/v3/login \
    "{\"type\":\"m.login.application_service\",\"identifier\":{\"type\":\"m.id.user\",\"user\":\"$LOCALPART\"},\"initial_device_display_name\":\"Password check\"}" \
    | sed -nE 's/.*"access_token": *"([^"]*)".*/\1/p')
if [ -z "$CHECK" ]; then
    reply '{"enabled":true,"error":"Your Matrix account doesn'"'"'t exist yet or is deactivated. Open Element from the sidebar once first."}'
fi
wget -q -O /dev/null --header "Authorization: Bearer $CHECK" --post-data '{}' \
    "$INTERNAL_URL/_matrix/client/v3/logout" 2>/dev/null

SERVER_PID=$(cat /tmp/conduwuit.pid 2>/dev/null)
[ -n "$SERVER_PID" ] || reply '{"enabled":true,"error":"The Matrix server is not running."}'

# One change at a time; a lock left by a crash expires after a minute
if ! mkdir "$LOCK" 2>/dev/null; then
    if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
        rm -rf "$LOCK"
        mkdir "$LOCK" 2>/dev/null || reply '{"enabled":true,"error":"Busy, try again in a moment."}'
    else
        reply '{"enabled":true,"error":"Busy, try again in a moment."}'
    fi
fi

clear_command() {
    (umask 077 && printf '[global]\nadmin_signal_execute = []\n' > "$SIGNAL_CONFIG")
    kill -USR1 "$SERVER_PID" 2>/dev/null
    rm -rf "$LOCK"
}
trap clear_command EXIT

(umask 077 && printf "[global]\nadmin_signal_execute = ['users reset-password --convert-to-local-account %s %s']\n" \
    "$LOCALPART" "$PASSWORD" > "$SIGNAL_CONFIG")

LOGIN="{\"type\":\"m.login.password\",\"identifier\":{\"type\":\"m.id.user\",\"user\":\"$LOCALPART\"},\"password\":\"$(json_escape "$PASSWORD")\",\"initial_device_display_name\":\"Password check\"}"

# Reload, run, then confirm by signing in with the new password (and straight
# back out). Retry once in case the run signal beat the reload.
for attempt in 1 2; do
    kill -USR1 "$SERVER_PID" 2>/dev/null
    sleep 1
    kill -USR2 "$SERVER_PID" 2>/dev/null
    for _ in 1 2 3 4 5; do
        sleep 1
        TOKEN=$(wget -q -O - --header "Content-Type: application/json" --post-data "$LOGIN" \
            "$INTERNAL_URL/_matrix/client/v3/login" 2>/dev/null \
            | sed -nE 's/.*"access_token": *"([^"]*)".*/\1/p')
        if [ -n "$TOKEN" ]; then
            wget -q -O /dev/null --header "Authorization: Bearer $TOKEN" --post-data '{}' \
                "$INTERNAL_URL/_matrix/client/v3/logout" 2>/dev/null
            reply "{\"enabled\":true,\"ok\":true,\"user_id\":\"$(json_escape "$USER_ID")\"}"
        fi
    done
done

reply '{"enabled":true,"error":"The password could not be set. Check the add-on log."}'
