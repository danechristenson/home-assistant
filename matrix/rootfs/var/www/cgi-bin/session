#!/bin/sh
# Signs the Home Assistant user who opened the ingress panel in to Matrix.
#
# GET  -> which Matrix user this Home Assistant user maps to
# POST -> log in as that user (creating the account if needed) and return a
#         new session for Element
#
# Only the Home Assistant ingress proxy can reach this script, and it sets the
# X-Remote-User-* headers from the logged-in Home Assistant session.

reply() {
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n%s\n' "$1"
    exit 0
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037'
}

. /tmp/autologin.env 2>/dev/null || reply '{"enabled":false}'
[ "$AUTOLOGIN" = "true" ] || reply '{"enabled":false}'

if [ -z "$HTTP_X_REMOTE_USER_NAME" ]; then
    reply '{"enabled":true,"error":"Home Assistant did not say which user is signed in."}'
fi

LOCALPART=$(printf '%s' "$HTTP_X_REMOTE_USER_NAME" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9._=-]/_/g')
USER_ID="@$LOCALPART:$SERVER_NAME"
DISPLAY_NAME=$(json_escape "${HTTP_X_REMOTE_USER_DISPLAY_NAME:-$HTTP_X_REMOTE_USER_NAME}")

# Never hand out the server's own bot accounts
case "$LOCALPART" in
    conduit | _ha_autologin)
        reply "{\"enabled\":true,\"error\":\"The Home Assistant username '$LOCALPART' is reserved by the Matrix server.\"}"
        ;;
esac

USER_JSON="\"user_id\":\"$(json_escape "$USER_ID")\",\"display_name\":\"$DISPLAY_NAME\",\"localpart\":\"$LOCALPART\",\"homeserver_url\":\"$(json_escape "$HOMESERVER_URL")\""

# Until the first account is created with the server's one-time token, offer
# that instead, so the person setting up the server becomes its admin
SETUP_TOKEN=$(cat /tmp/setup_token 2>/dev/null)
if [ -n "$SETUP_TOKEN" ] && wget -q -O - \
    "$INTERNAL_URL/_matrix/client/v1/register/m.login.registration_token/validity?token=$SETUP_TOKEN" 2>/dev/null \
    | grep -q '"valid": *true'; then
    reply "{\"enabled\":true,$USER_JSON,\"setup_url\":\"$(json_escape "$HOMESERVER_URL")/_continuwuity/account/register/?flow=trusted&token=$SETUP_TOKEN\"}"
fi

if [ "$REQUEST_METHOD" != "POST" ]; then
    reply "{\"enabled\":true,$USER_JSON}"
fi

api() {
    wget -q -O - \
        --header "Authorization: Bearer $AS_TOKEN" \
        --header "Content-Type: application/json" \
        --post-data "$2" \
        "$INTERNAL_URL$1" 2>/dev/null
}

field() {
    printf '%s' "$RESPONSE" | sed -nE "s/.*\"$1\": *\"([^\"]*)\".*/\1/p"
}

LOGIN="{\"type\":\"m.login.application_service\",\"identifier\":{\"type\":\"m.id.user\",\"user\":\"$LOCALPART\"},\"initial_device_display_name\":\"Home Assistant\"}"
CREATED=false

if ! RESPONSE=$(api /_matrix/client/v3/login "$LOGIN"); then
    # No account yet: create one, then log in
    if ! api /_matrix/client/v3/register \
        "{\"type\":\"m.login.application_service\",\"username\":\"$LOCALPART\",\"inhibit_login\":true}" >/dev/null; then
        reply '{"enabled":true,"error":"Could not create a Matrix account for this user. Check the add-on log."}'
    fi
    CREATED=true
    if ! RESPONSE=$(api /_matrix/client/v3/login "$LOGIN"); then
        reply '{"enabled":true,"error":"Could not sign in to Matrix. Check the add-on log."}'
    fi
fi

reply "{\"enabled\":true,$USER_JSON,\"created\":$CREATED,\"device_id\":\"$(field device_id)\",\"access_token\":\"$(field access_token)\"}"
